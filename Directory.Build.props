<Project>

  <!--
    Single authoritative product version for BladeControl. Assemblies, the UI, the
    Windows service, the installer and the release workflow all derive their version
    from these three properties; nothing downstream hard-codes a version string.

    To cut a new version, edit BladeControlVersionPrefix (and the suffix when the
    build is a prerelease) here and nowhere else.
  -->
  <PropertyGroup>
    <BladeControlVersionPrefix>0.1.0</BladeControlVersionPrefix>
    <BladeControlVersionSuffix></BladeControlVersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>$(BladeControlVersionPrefix)</VersionPrefix>
    <VersionSuffix>$(BladeControlVersionSuffix)</VersionSuffix>

    <!--
      AssemblyVersion stays on the major.minor.patch.0 form Windows expects, so the
      MSI can compare file versions during a major upgrade. InformationalVersion
      carries the full semantic version including any prerelease suffix.
    -->
    <AssemblyVersion>$(BladeControlVersionPrefix).0</AssemblyVersion>
    <FileVersion>$(BladeControlVersionPrefix).0</FileVersion>
  </PropertyGroup>

  <!--
    Stamp the source commit into InformationalVersion, so a running service can say which
    build it is. During live diagnosis "the installed runtime predates commit X" was a
    deduction from file hashes; it should be a fact the runtime reports about itself.

    Failure is deliberately silent: a build from an exported tarball with no git metadata
    still succeeds, it simply carries no revision.
  -->
  <Target Name="StampSourceRevision" BeforeTargets="GetAssemblyVersion"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BladeControlGitHead" />
      <Output TaskParameter="ExitCode" PropertyName="_BladeControlGitExit" />
    </Exec>
    <PropertyGroup Condition="'$(_BladeControlGitExit)' == '0'">
      <SourceRevisionId>$(_BladeControlGitHead.Trim())</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Publisher and product metadata surfaced in file properties and Installed Apps. -->
  <PropertyGroup>
    <Product>BladeControl</Product>
    <Company>BladeControl Project</Company>
    <Authors>BladeControl Project</Authors>
    <Copyright>Copyright (c) BladeControl Project</Copyright>

    <!--
      The variant, declared once. GPL-3.0 alone does not say whether later versions apply, and
      "or-later" is what the FSF's own boilerplate uses. It costs the copyright holder nothing
      here - a sole holder can relicense at will either way - and it keeps the option open
      without needing anyone's agreement later. Every built assembly carries it.
    -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    Deterministic Release output so the same source produces byte-identical
    assemblies, which is what makes the published SHA256 hashes meaningful.
    ContinuousIntegrationBuild normalises embedded source paths and is set by CI.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
