<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>BladeControl.UI</RootNamespace>
    <AssemblyName>BladeControl.UI</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    app.ico becomes the Win32 resource above (taskbar, Start menu, installer ARP icon).
    The three tray-state icons are separate: NotificationAreaService loads them at runtime
    from these WPF pack resources, so they resolve identically whether the app runs from the
    build output, an MSI install under Program Files, or the portable zip — a loose file path
    would have to be re-derived per packaging mode, this doesn't.
  -->
  <ItemGroup>
    <Resource Include="Assets\tray-idle.ico" />
    <Resource Include="Assets\tray-warning.ico" />
    <Resource Include="Assets\tray-emergency.ico" />
  </ItemGroup>

  <!--
    The Windows Forms SDK adds implicit global usings that collide with WPF
    (Application, MessageBox, Clipboard). The notification-area host is the only
    file that touches Windows Forms and it qualifies every type explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    Runtime Core V1 currently owns its typed IPC DTOs and operations, so this is
    the UI's sole production project reference. Runtime transitively exposes the
    safe Razer/Telemetry/Thermal model assemblies, but the UI must NOT reference
    BladeControl.Service or BladeControl.Hardware.Windows: those pull the Windows
    host and hardware providers into the GUI process. Contract extraction is
    tracked in docs/gui-backend-needs.md; the direct-reference boundary is tested
    by BladeControl.UI.Tests.
  -->
  <ItemGroup>
    <ProjectReference Include="..\BladeControl.Ipc\BladeControl.Ipc.csproj" />
    <ProjectReference Include="..\BladeControl.Runtime\BladeControl.Runtime.csproj" />
  </ItemGroup>

</Project>
