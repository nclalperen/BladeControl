<Window x:Class="BladeControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BladeControl.UI.ViewModels"
        Title="BladeControl"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,0,8,26">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="{StaticResource PanelCornerRadius}"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#071008"
                                       FontWeight="Bold"
                                       FontSize="18" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BladeControl"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <TextBlock Text="Runtime client"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         Style="{StaticResource NavigationListStyle}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{Binding Glyph}"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,8,0"
                                         Fill="{Binding ConnectionTone, Converter={StaticResource StatusToneBrushConverter}}" />
                                <TextBlock Text="{Binding ConnectionLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding RuntimeStateLabel}"
                                       Margin="16,3,0,0"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Button Content="Compact panel"
                            Click="OnCompactPanelClick"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,10" />
                    <CheckBox Content="Close to notification area"
                              IsChecked="{Binding MinimizeToTray}"
                              Style="{StaticResource SubtleCheckBoxStyle}"
                              ToolTip="When enabled, closing this window keeps only the UI in the notification area. Runtime Core continues independently." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="30,20,30,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTitle}"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding CurrentSubtitle}"
                               Margin="{StaticResource ValueCaptionMargin}"
                               Style="{StaticResource SubtitleTextStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="30,0,30,14"
                    Padding="14,11"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    Background="{Binding ConnectionNoticeTone, Converter={StaticResource StatusToneBrushConverter}, ConverterParameter=Background}"
                    BorderBrush="{Binding ConnectionNoticeTone, Converter={StaticResource StatusToneBrushConverter}}"
                    BorderThickness="1"
                    Visibility="{Binding HasConnectionNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionNoticeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding ConnectionNoticeTone, Converter={StaticResource StatusToneBrushConverter}}" />
                        <TextBlock Text="{Binding ConnectionNoticeDetail}"
                                   Margin="0,3,12,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Reconnect"
                            Command="{Binding ReconnectCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding CanReconnect, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="2"
                            Content="{Binding SelectedPage}"
                            Margin="0" />
        </Grid>
    </Grid>
</Window>
