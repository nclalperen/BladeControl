<UserControl x:Class="BladeControl.UI.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,0,30,30">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Read-only Runtime Core report" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="No write console or direct hardware path is exposed here."
                                   Margin="0,5,0,0"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Copy diagnostics"
                            Command="{Binding CopyDiagnosticsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Margin="0,0,0,14"
                    Padding="13,10"
                    CornerRadius="9"
                    Background="{StaticResource NeutralBackgroundBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,14,14" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="15">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Value}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Tone, Converter={StaticResource StatusToneBrushConverter}}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Margin="0,3,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Runtime events" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{Binding EventSummary}" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding EventKinds}"
                                      SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                                      MinWidth="150"
                                      Margin="0,0,8,0" />
                            <Button Content="Clear" Command="{Binding ClearEventsCommand}" Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Padding="12,9"
                            Margin="0,0,0,10"
                            CornerRadius="8"
                            Background="{StaticResource WarningBackgroundBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1"
                            Visibility="{Binding GapDetected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="The runtime event stream had a retention gap or restarted. Earlier entries may be unavailable."
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ListBox ItemsSource="{Binding FilteredEvents}"
                             Height="430"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9"
                                        CornerRadius="9"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Foreground="{StaticResource TextPrimaryBrush}">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Kind}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Tone, Converter={StaticResource StatusToneBrushConverter}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="217,9,0,1"
                                                   Padding="0,8,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
