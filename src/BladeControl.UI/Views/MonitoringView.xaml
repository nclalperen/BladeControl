<UserControl x:Class="BladeControl.UI.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BladeControl.UI.Controls"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PageContentMargin}">
            <Border Margin="{StaticResource CardGapMargin}"
                    Padding="14,10"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderThickness="1"
                    Background="{StaticResource WarningBackgroundBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StaleLabel}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="{StaticResource CardGapMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SampleCountLabel}" Margin="{StaticResource LabelValueMargin}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="4" CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource SurfaceRaisedBrush}" Margin="0,0,9,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="60 s" IsChecked="{Binding Is60Seconds}" Style="{StaticResource SegmentToggleStyle}" GroupName="GraphRange" />
                                <RadioButton Content="120 s" IsChecked="{Binding Is120Seconds}" Style="{StaticResource SegmentToggleStyle}" GroupName="GraphRange" />
                            </StackPanel>
                        </Border>
                        <Button Content="Clear history" Command="{Binding ClearCommand}" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Charts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,14,14" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="14">
                            <StackPanel>
                                <controls:TelemetryChart Chart="{Binding}" Height="215" />
                                <ItemsControl ItemsSource="{Binding Series}" Margin="2,9,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsVisible}"
                                                      Margin="0,0,14,5"
                                                      Style="{StaticResource SubtleCheckBoxStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding ColorHex}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding LatestText}" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="11" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
