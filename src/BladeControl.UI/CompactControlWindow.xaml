<Window x:Class="BladeControl.UI.CompactControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BladeControl"
        Width="400"
        MaxHeight="596"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WindowCornerRadius}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.48" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,14,12,10" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BladeControl" Style="{StaticResource CompactTitleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MetricValueMargin}">
                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 Fill="{Binding ConnectionTone, Converter={StaticResource StatusToneBrushConverter}}" />
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="↗"
                        ToolTip="Open Full App" Style="{StaticResource CompactIconButtonStyle}"
                        Click="OnFullAppClick" />
                <Button Grid.Column="2" Content="×"
                        ToolTip="Hide BladeControl" Style="{StaticResource CompactIconButtonStyle}"
                        Click="OnCloseClick" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" MaxHeight="490">
                <StackPanel Margin="14,0,14,10">
                    <Grid Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding CpuTemperature}" Style="{StaticResource CompactMetricTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="GPU" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding GpuTemperature}" Style="{StaticResource CompactMetricTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TelemetryCaption}" Margin="4,-6,4,10"
                               Style="{StaticResource CompactCaptionTextStyle}"
                               Foreground="{Binding TelemetryTone, Converter={StaticResource StatusToneBrushConverter}}" />

                    <Border Style="{StaticResource CompactCardStyle}" Margin="{StaticResource CompactCardGapMargin}">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" Style="{StaticResource EyebrowTextStyle}" Margin="{StaticResource CompactEyebrowMargin}" />
                            <UniformGrid Columns="3">
                                <RadioButton Content="Balanced" GroupName="PerformanceMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsBalancedSelected, Mode=OneWay}"
                                             Command="{Binding SelectBalancedCommand}" />
                                <RadioButton Content="Silent" GroupName="PerformanceMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsSilentSelected, Mode=OneWay}"
                                             Command="{Binding SelectSilentCommand}" />
                                <RadioButton Content="Custom" GroupName="PerformanceMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsCustomSelected, Mode=OneWay}"
                                             Command="{Binding SelectCustomCommand}" />
                            </UniformGrid>
                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding IsCustomSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <RadioButton Content="Low" GroupName="CpuLevel" Style="{StaticResource SegmentToggleStyle}"
                                                 IsChecked="{Binding IsCpuLowSelected, Mode=OneWay}"
                                                 Command="{Binding SelectCpuLowCommand}" />
                                    <RadioButton Content="Medium" GroupName="CpuLevel" Style="{StaticResource SegmentToggleStyle}"
                                                 IsChecked="{Binding IsCpuMediumSelected, Mode=OneWay}"
                                                 Command="{Binding SelectCpuMediumCommand}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="GPU  Low" Margin="12,0" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyCustomCommand}"
                                        Style="{StaticResource CompactPrimaryButtonStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding Performance.ApplyBlockedReason}" Margin="0,7,0,0"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCardStyle}">
                        <StackPanel>
                            <TextBlock Text="COOLING" Style="{StaticResource EyebrowTextStyle}" Margin="{StaticResource CompactEyebrowMargin}" />
                            <UniformGrid Columns="3">
                                <RadioButton Content="Auto" GroupName="CoolingMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsAutoSelected, Mode=OneWay}"
                                             Command="{Binding SelectAutoCommand}" />
                                <RadioButton Content="Fixed" GroupName="CoolingMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsFixedSelected, Mode=OneWay}"
                                             Command="{Binding SelectFixedCommand}" />
                                <RadioButton Content="Dynamic" GroupName="CoolingMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsDynamicSelected, Mode=OneWay}"
                                             Command="{Binding SelectDynamicCommand}" />
                            </UniformGrid>

                            <StackPanel Margin="{StaticResource CompactSectionGapMargin}"
                                        Visibility="{Binding IsFixedSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Fan 1" />
                                    <TextBlock Grid.Column="1" Text="{Binding Fans.Fan1Target, StringFormat={}{0:N0} RPM}" FontWeight="SemiBold" />
                                </Grid>
                                <Slider Minimum="2000" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True"
                                        Value="{Binding Fans.Fan1Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Fan 2" />
                                    <TextBlock Grid.Column="1" Text="{Binding Fans.Fan2Target, StringFormat={}{0:N0} RPM}" FontWeight="SemiBold" />
                                </Grid>
                                <Slider Minimum="2000" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True"
                                        Value="{Binding Fans.Fan2Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Apply Fixed" HorizontalAlignment="Right"
                                        Command="{Binding ApplyFixedCommand}"
                                        Style="{StaticResource CompactPrimaryButtonStyle}" />
                            </StackPanel>

                            <StackPanel Margin="{StaticResource CompactSectionGapMargin}"
                                        Visibility="{Binding IsDynamicSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Dynamic Cooling" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DynamicState}" />
                                </Grid>
                                <TextBlock Text="{Binding DynamicTarget, StringFormat=Current target: {0}}"
                                           Margin="0,3,0,7" Style="{StaticResource CaptionTextStyle}" />
                                <Button Content="Start Dynamic Cooling" Command="{Binding StartDynamicCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="{Binding IsDynamicStopped, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Stop Dynamic Cooling" Command="{Binding StopDynamicCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsDynamicRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding DynamicBlockedReason}" Margin="0,6,0,0"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Visibility="{Binding HasDynamicBlockedReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="{StaticResource CompactSectionGapMargin}" Padding="10,7" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{Binding OperationTone, Converter={StaticResource StatusToneBrushConverter}, ConverterParameter=Background}"
                            Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap"
                                   Foreground="{Binding OperationTone, Converter={StaticResource StatusToneBrushConverter}}" />
                    </Border>

                    <Expander Header="Settings" Margin="2,8,2,0" Foreground="{StaticResource TextMutedBrush}">
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Launch mode" Style="{StaticResource CaptionTextStyle}" />
                                <ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding LaunchMode}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Compact close" Style="{StaticResource CaptionTextStyle}" />
                                <ComboBox ItemsSource="{Binding CloseBehaviors}" SelectedItem="{Binding CompactCloseBehavior}" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 Fill="{Binding FooterTone, Converter={StaticResource StatusToneBrushConverter}}" />
                        <TextBlock Text="{Binding FooterText}" Style="{StaticResource CompactStatusTextStyle}"
                                   Foreground="{Binding FooterTone, Converter={StaticResource StatusToneBrushConverter}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Diagnostics" Click="OnDiagnosticsClick"
                            Style="{StaticResource CompactGhostButtonStyle}" />
                    <Button Grid.Column="2" Content="Full App" Click="OnFullAppClick"
                            Style="{StaticResource CompactGhostButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
