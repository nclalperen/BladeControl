<Window x:Class="BladeControl.UI.CompactControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BladeControl"
        Width="400"
        MaxHeight="596"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WindowCornerRadius}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.48" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,14,12,10" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BladeControl" Style="{StaticResource CompactTitleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MetricValueMargin}">
                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 Fill="{Binding ConnectionTone, Converter={StaticResource StatusToneBrushConverter}}" />
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="↗"
                        ToolTip="Open Full App" Style="{StaticResource CompactIconButtonStyle}"
                        Click="OnFullAppClick" />
                <Button Grid.Column="2" Content="×"
                        ToolTip="Hide BladeControl" Style="{StaticResource CompactIconButtonStyle}"
                        Click="OnCloseClick" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" MaxHeight="490">
                <StackPanel Margin="14,0,14,10">
                    <!--
                        CPU, FAN, GPU. The fan figure is deliberately not called RPM: no physical
                        tachometer has been found on this machine, so what is shown is the target
                        BladeControl asked for, labelled as a target. Under firmware Auto there is
                        no BladeControl target at all and the heading says so.
                    -->
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding CpuTemperature}" Style="{StaticResource CompactMetricTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FanHeading}" Style="{StaticResource EyebrowTextStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FanValue}" Style="{StaticResource CompactMetricTextStyle}"
                                       HorizontalAlignment="Center"
                                       Foreground="{Binding FanTone, Converter={StaticResource StatusToneBrushConverter}}" />
                            <TextBlock Text="{Binding FanCaption}" Style="{StaticResource CompactCaptionTextStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="GPU" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding GpuTemperature}" Style="{StaticResource CompactMetricTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TelemetryCaption}" Margin="4,-6,4,10"
                               Style="{StaticResource CompactCaptionTextStyle}"
                               Foreground="{Binding TelemetryTone, Converter={StaticResource StatusToneBrushConverter}}" />

                    <!--
                        A latched terminal state, placed above the controls it invalidates. It is
                        not "in progress": nothing resolves on its own, because resuming Dynamic
                        automatically after a thermal emergency is how a loop starts.
                    -->
                    <Border Margin="{StaticResource CompactCardGapMargin}" Padding="12,10"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Background="{StaticResource WarningBackgroundBrush}"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Visibility="{Binding IsEmergencyHandoff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EmergencyTitle}" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EmergencyDetail}" Margin="0,4,0,0"
                                       Style="{StaticResource CompactCaptionTextStyle}" />
                            <TextBlock Text="{Binding EmergencyAction}" Margin="0,6,0,0"
                                       Style="{StaticResource CompactCaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCardStyle}" Margin="{StaticResource CompactCardGapMargin}">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" Style="{StaticResource EyebrowTextStyle}" Margin="{StaticResource CompactEyebrowMargin}" />
                            <UniformGrid Columns="3">
                                <RadioButton Content="Balanced" GroupName="PerformanceMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsBalancedSelected, Mode=OneWay}"
                                             Command="{Binding SelectBalancedCommand}" />
                                <RadioButton Content="Silent" GroupName="PerformanceMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsSilentSelected, Mode=OneWay}"
                                             Command="{Binding SelectSilentCommand}" />
                                <RadioButton Content="Custom" GroupName="PerformanceMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsCustomSelected, Mode=OneWay}"
                                             Command="{Binding SelectCustomCommand}" />
                            </UniformGrid>
                            <!--
                                CPU and GPU as separate rows, listing every level the protocol
                                models. The ones this build will not send are shown disabled
                                rather than omitted: an absent level looks like hardware that
                                does not have it, while a greyed one says the protocol models it
                                and it has not been validated here — which is what is true. Their
                                tooltip carries the reason.
                            -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsCustomSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" VerticalAlignment="Center"
                                               Style="{StaticResource CompactCaptionTextStyle}" />
                                    <ListBox Grid.Column="1"
                                             ItemsSource="{Binding CpuLevels}"
                                             SelectedValuePath="Value"
                                             SelectedValue="{Binding Performance.SelectedCpuLevel, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource CompactPolicyOptionTemplate}"
                                             ItemContainerStyle="{StaticResource CompactPolicyItemStyle}"
                                             Style="{StaticResource CompactPolicyListStyle}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" VerticalAlignment="Center"
                                               Style="{StaticResource CompactCaptionTextStyle}" />
                                    <ListBox Grid.Column="1"
                                             ItemsSource="{Binding GpuLevels}"
                                             SelectedValuePath="Value"
                                             SelectedValue="{Binding Performance.SelectedGpuLevel, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource CompactPolicyOptionTemplate}"
                                             ItemContainerStyle="{StaticResource CompactPolicyItemStyle}"
                                             Style="{StaticResource CompactPolicyListStyle}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Grid>
                                <Button Content="Apply" HorizontalAlignment="Right" Margin="0,8,0,0"
                                        Command="{Binding ApplyCustomCommand}"
                                        Style="{StaticResource CompactPrimaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Performance.ApplyBlockedReason}" Margin="0,7,0,0"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCardStyle}">
                        <StackPanel>
                            <TextBlock Text="COOLING" Style="{StaticResource EyebrowTextStyle}" Margin="{StaticResource CompactEyebrowMargin}" />
                            <!--
                                The firmware options are named rather than lumped under "Auto".
                                Firmware's fan curve is the performance mode's curve, so picking
                                Silent or Balanced hands the fans back and says which curve takes
                                over - one operation, since applying a performance mode already
                                writes fan mode Auto.
                            -->
                            <UniformGrid Columns="4">
                                <RadioButton Content="Silent" GroupName="CoolingMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsFirmwareSilentSelected, Mode=OneWay}"
                                             Command="{Binding SelectFirmwareSilentCommand}" />
                                <RadioButton Content="Balanced" GroupName="CoolingMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsFirmwareBalancedSelected, Mode=OneWay}"
                                             Command="{Binding SelectFirmwareBalancedCommand}" />
                                <RadioButton Content="Fixed" GroupName="CoolingMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsFixedSelected, Mode=OneWay}"
                                             Command="{Binding SelectFixedCommand}" />
                                <RadioButton Content="Dynamic" GroupName="CoolingMode"
                                             Style="{StaticResource SegmentToggleStyle}"
                                             IsChecked="{Binding IsDynamicSelected, Mode=OneWay}"
                                             Command="{Binding SelectDynamicCommand}" />
                            </UniformGrid>

                            <TextBlock Text="Firmware owns cooling. BladeControl is not commanding the fans."
                                       Margin="{StaticResource CompactSectionGapMargin}"
                                       Style="{StaticResource CompactCaptionTextStyle}"
                                       Visibility="{Binding IsFirmwareSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Margin="{StaticResource CompactSectionGapMargin}"
                                        Visibility="{Binding IsFixedSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!--
                                    One fan control. The machine has two fans and the protocol
                                    addresses them separately, which the runtime keeps doing and
                                    still verifies per zone. Asking the user to set them
                                    independently offered a decision with no basis for making it
                                    and an easy way to desynchronise the zones for no benefit.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Fan target" />
                                    <TextBlock Grid.Column="1" Text="{Binding FanTarget, StringFormat={}{0:N0}}"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Slider Minimum="{Binding MinimumFanRpm}" Maximum="{Binding MaximumFanRpm}"
                                        TickFrequency="{Binding FanRpmIncrement}" IsSnapToTickEnabled="True"
                                        Value="{Binding FanTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Both fans receive this target. It is a command, not a measured speed."
                                           Style="{StaticResource CompactCaptionTextStyle}" Margin="0,2,0,0" />
                                <Button Content="Apply Fixed" HorizontalAlignment="Right" Margin="0,6,0,0"
                                        Command="{Binding ApplyFixedCommand}"
                                        Style="{StaticResource CompactPrimaryButtonStyle}" />
                            </StackPanel>

                            <StackPanel Margin="{StaticResource CompactSectionGapMargin}"
                                        Visibility="{Binding IsDynamicSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Dynamic Cooling" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DynamicState}" />
                                </Grid>
                                <TextBlock Text="{Binding DynamicTarget, StringFormat=Current target: {0}}"
                                           Margin="0,3,0,7" Style="{StaticResource CaptionTextStyle}" />
                                <Button Content="Start Dynamic Cooling" Command="{Binding StartDynamicCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="{Binding IsDynamicStopped, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Stop Dynamic Cooling" Command="{Binding StopDynamicCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsDynamicRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding DynamicBlockedReason}" Margin="0,6,0,0"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Visibility="{Binding HasDynamicBlockedReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="{StaticResource CompactSectionGapMargin}" Padding="10,7" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{Binding OperationTone, Converter={StaticResource StatusToneBrushConverter}, ConverterParameter=Background}"
                            Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap"
                                   Foreground="{Binding OperationTone, Converter={StaticResource StatusToneBrushConverter}}" />
                    </Border>

                    <Expander Header="Settings" Margin="2,8,2,0" Foreground="{StaticResource TextMutedBrush}">
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Launch mode" Style="{StaticResource CaptionTextStyle}" />
                                <ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding LaunchMode}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Compact close" Style="{StaticResource CaptionTextStyle}" />
                                <ComboBox ItemsSource="{Binding CloseBehaviors}" SelectedItem="{Binding CompactCloseBehavior}" />
                            </StackPanel>
                            <CheckBox Grid.Row="1" Grid.ColumnSpan="2"
                                      Margin="{StaticResource CompactSectionGapMargin}"
                                      Content="Start BladeControl with Windows"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      Style="{StaticResource SubtleCheckBoxStyle}" />
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 Fill="{Binding FooterTone, Converter={StaticResource StatusToneBrushConverter}}" />
                        <TextBlock Text="{Binding FooterText}" Style="{StaticResource CompactStatusTextStyle}"
                                   Foreground="{Binding FooterTone, Converter={StaticResource StatusToneBrushConverter}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Diagnostics" Click="OnDiagnosticsClick"
                            Style="{StaticResource CompactGhostButtonStyle}" />
                    <Button Grid.Column="2" Content="Full App" Click="OnFullAppClick"
                            Style="{StaticResource CompactGhostButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
