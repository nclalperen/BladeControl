  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BladeControl.Runtime\BladeControl.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
